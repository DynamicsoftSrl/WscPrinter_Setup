@page
@model WscPrinter_Setup.Pages.WscBuilder.Step03_products_sold.Step03ProductsSoldModel
@{
  List<SelectListItem> prodItems = new List<SelectListItem> {
      new SelectListItem { Value = "CRT", Text = "carta" }
      , new SelectListItem { Value = "STP", Text = "stampanti"  }
      , new SelectListItem { Value = "CMP", Text = "computers"  }
      , new SelectListItem { Value = "CNC", Text = "cancelleria"  }
      , new SelectListItem { Value = "GMM", Text = "gomme"  }
      , new SelectListItem { Value = "RGH", Text = "righelli"  }
      , new SelectListItem { Value = "TTT", Text = "etichette"  }
      , new SelectListItem { Value = "PNN", Text = "pennarelli"  }
  };
  ViewData["Title"] = "Step 3";

}

<!--
=============================================
  WBUILDER - STEP 3
==============================================
-->
<div class="wbuilder-page">
  <div class="wbuilder-column-1 d-lg-flex align-items-center">
    <div class="wbuilder-img-logo"><a asp-area="" asp-page="/Index"><img src="/images/website/logo_wscprinter_v_dark.svg" alt="Wsc Printer - Web To Print" title="Wsc Printer - Web To Print" class="wsc-logo"></a></div>
    <div class="wbuilder-info" data-aos="fade-right" data-aos-duration="1200">
      <h2>What printing products <br />or services would you  <br>like to sell online?</h2>
    </div>
  </div>
  <div class="wbuilder-column-2 d-lg-flex align-items-center">
    <div class="wbuilder-info" data-aos="fade-left" data-aos-duration="1200">
      <p class="text">Choose one or more products that you would like to sell online</p>
      <div class="togglers">
        <div id="alertError" class="alert alert-warning wbuilder-hidden">
          <div class="fa fa-warning"> <span>Choose one option. Please.</span> </div>
        </div>
      </div>
      <form id="selectProductsSold" asp-page="/WscBuilder/Step04_reference_websites/Index" method="post" class="form-horizontal" role="form">
        <div class="step-block">
          <div class="row">
            <div class="col-sm-6">
              <div class="form-group">
                <input type="checkbox" name="ProductsSold" class="form-control" id="prodotti_commerciali" value="prodotti_commerciali" onclick="hideAlert()" required>
                <label for="prodotti_commerciali">Commercial products</label>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="form-group">
                <input type="checkbox" name="ProductsSold" class="form-control" id="prodotti_editoriali" value="prodotti_editoriali" onclick="hideAlert()" required>
                <label for="prodotti_editoriali">Publishing products</label>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-sm-6">
              <div class="form-group">
                <input type="checkbox" name="ProductsSold" class="form-control" id="prodotti_grande_formato" value="prodotti_grande_formato" onclick="hideAlert()" required>
                <label for="prodotti_grande_formato">Large format products</label>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="form-group">
                <input type="checkbox" name="ProductsSold" class="form-control" id="espositori" value="espositori" onclick="hideAlert()" required>
                <label for="espositori">Displays</label>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-sm-6">
              <div class="form-group">
                <input type="checkbox" name="ProductsSold" class="form-control" id="prodotti_packaging" value="prodotti_packaging" onclick="hideAlert()" required>
                <label for="prodotti_packaging">Packaging products</label>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="form-group">
                <input type="checkbox" name="ProductsSold" class="form-control" id="etichette" value="etichette" onclick="hideAlert()" required>
                <label for="etichette">Label</label>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-sm-6">
              <div class="form-group">
                <input type="checkbox" name="ProductsSold" class="form-control" id="prodotti_serigrafici" value="prodotti_serigrafici" required>
                <label for="prodotti_serigrafici">Screen printing products</label>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="form-group">
                <input type="checkbox" name="ProductsSold" class="form-control" id="gadget_personalizzati" value="gadget_personalizzati" onclick="hideAlert()" required>
                <label for="gadget_personalizzati">Custom gadgets</label>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-sm-6">
              <div class="form-group">
                <input type="checkbox" name="ProductsSold" class="form-control" id="abbigliamento" value="abbigliamento" onclick="hideAlert()" required>
                <label for="abbigliamento">Custom clothing</label>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="form-group">
                <input type="checkbox" name="ProductsSold" class="form-control" id="servizi" value="servizi" onclick="hideAlert()" required>
                <label for="servizi">Various types of services</label>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-sm-12">
              <div class="form-group">
                <textarea class="form-control" name="OtherProductsSold" id="id_OtherProductsSold" placeholder="Add other products or services not present" onkeydown="hideAlert()"></textarea>
              </div>
            </div>
          </div>
        </div>
        <div class="wbuilder-button">
          <a href="#" class="theme-btn-nine" onclick="validateSubmit('selectProductsSold','ProductsSold','OtherProductsSold')">@Localizer["Next"]</a>
        </div>
      </form>
    </div>
  </div>
</div>

<script type="text/javascript">
  function validateSubmit(frmId, nameOfItem, nameOfTxt) {
    const theForm = document.getElementById(frmId);
    const chkBxs = theForm.elements.namedItem(nameOfItem);
    let canGo = false;
    chkBxs.forEach(chbx => {
      canGo = canGo || chbx.checked;
    });
    const checkbox = theForm.elements.namedItem(nameOfTxt).value;
    canGo = canGo || (checkbox?.length > 0);
    if (canGo) {
      theForm.submit()
    } else {
      effect("#alertError");
    }
  }
  function hideAlert() {
    $("#alertError").addClass("wbuilder-hidden");
  };


</script>
