<script>
  function leave() {
    var url = '@templateLink';
    window.open(url, '_blank');
    }

    window.onload = function () {
        var customerName = GetCustomerName();
		var template='@templateId';
        var linkWhatsapp = "https://wa.me/+390287388790/?text=Salve%20sono%20"+ customerName + "%2C%0Aho%20creato%20il%20mio%20sito%20Web%20To%20Print.%0A%5B"+template+"%5D%0AVorrei%20maggiori%20informazioni.%0AGrazie%0A"
		  document.getElementById("whatsapp1").href = linkWhatsapp;
		   document.getElementById("whatsapp2").href = linkWhatsapp;
    };


    function GetCustomerName() {
        let value = getCookie("CustomerName");
        if (value != null || value != "") {
          return value;
        }
        else {
            GetCustomerName()
        }
    }
    function getCookie(cname) {
        let name = cname + "=";
        let ca = document.cookie.split(';');
        for (let i = 0; i < ca.length; i++) {
            let c = ca[i];
            while (c.charAt(0) == ' ') {
                c = c.substring(1);
            }
            if (c.indexOf(name) == 0) {
                return c.substring(name.length, c.length);
            }
        }
        return "";
    }
</script>
